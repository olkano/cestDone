# Required only when using --backend agent-sdk.
# Uses the Anthropic API with per-token billing.
# Not needed for --backend claude-cli (default, uses Max/Pro subscription).
# ANTHROPIC_API_KEY=sk-ant-api03-PK1...fwAA

# Set to true to enable verbose file logging
VERBOSE_LOGGING=true

# Email configuration (used by `cestdone send-email`)
# Provider: 'smtp' or 'sendgrid'
# MAIL_PROVIDER=sendgrid
# MAIL_FROM=notifier@itmplatform.com
#
# SendGrid (recommended):
# SENDGRID_API_KEY=replace-with-a-dedicated-mail-send-key
# SENDGRID_SANDBOX_MODE=true
# SENDGRID_ALLOW_LIVE_SEND=false
#
# SMTP (alternative):
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
